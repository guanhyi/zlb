{
    "compilerOptions": {
        "target": "ES2020",
        "experimentalDecorators": true,
        "lib": ["DOM", "ES2020"],
        "module": "ESNext",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "useDefineForClassFields": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}
